DATABASE_URL="postgresql://trace:trace@localhost:5432/trace?schema=public"

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
#   Authorization callback URL = <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# 세션 쿠키 HMAC 서명 키 — 32자 이상 랜덤.
#   생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# GitHub 토큰 AES-256 암호화 키 — 정확히 64 hex 문자(32바이트).
#   생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""

# OAuth redirect_uri 베이스. 로컬은 http://localhost:3000, 배포는 실제 도메인.
APP_URL="http://localhost:3000"
